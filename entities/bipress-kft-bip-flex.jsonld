          "name": "Mi a BIPRESS Kft. fő tevékenysége?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Szerelt hidraulika-, ipari- és légféktömlők egyedi és sorozatgyártása, tömlőkonfekcionálás és ipari fluidumtechnikai alkatrészellátás."
          }
        },
        {
          "@type": "Question",
          "name": "Mi a BIP-FLEX?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A BIP-FLEX a BIPRESS Kft. saját márkája."
          }
        },
        {
          "@type": "Question",
          "name": "Történik nyomáspróba a szerelt tömlőkön?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A BIPRESS ISO 1402 szerinti statikus hidrosztatikus nyomáspróbát is végez."
          }
        },
        {
          "@type": "Question",
          "name": "Vállalnak OEM és sorozatgyártási együttműködést?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Kis-, közepes és nagyszériás gyártás, OEM kiszolgálás és ütemezett beszállítás is része a működésnek."
          }
        },
        {
          "@type": "Question",
          "name": "Hol található a BIPRESS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Debrecenben; a székhely Nyíl utca 16., a nyilvános telephely Nyíl utca 14–16."
          }
        },
        {
          "@type": "Question",
          "name": "Mikor tart nyitva?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hétfőtől péntekig 08:00–16:00."
          }
        }
      ]
    },
