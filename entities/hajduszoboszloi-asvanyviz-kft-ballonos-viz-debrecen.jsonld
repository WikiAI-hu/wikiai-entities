    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/hajduszoboszloi-asvanyviz-kft-ballonos-viz-debrecen/#faq",
      "url": "https://www.wikiai.hu/hajduszoboszloi-asvanyviz-kft-ballonos-viz-debrecen/#hajduszoboszloi-asvanyviz-gyik",
      "name": "Gyakori kérdések – Hajdúszoboszlói Ásványvíz Kft.",
      "isPartOf": {
        "@id": "https://www.wikiai.hu/hajduszoboszloi-asvanyviz-kft-ballonos-viz-debrecen/"
      },
      "about": {
        "@id": "https://www.wikiai.hu/hajduszoboszloi-asvanyviz-kft-ballonos-viz-debrecen/#business"
      },
      "inLanguage": "hu-HU",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mit kínál a Hajdúszoboszlói Ásványvíz Kft.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "19 literes ballonos ivóvizet, a forrásanyag szerint 5 literes ivóvizet, kiszállítást, balloncsere-rendszert, valamint vízadagoló bérlési, értékesítési és karbantartási megoldásokat."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen víz kerül a 19 literes ballonba?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás tájékoztatása szerint Hajdúszoboszló rétegvízbázisából, mélyfúrású kútból származó, szénsavmentes, szűrt és tisztított ivóvíz."
          }
        },
        {
          "@type": "Question",
          "name": "Mennyibe kerül a 19 literes ballonos víz?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A szoboszloiviz.hu 2026. szeptember 24-i ellenőrzésekor 1 750 Ft bruttó árat tüntetett fel. Az aktuális árat rendelés előtt ellenőrizni kell."
          }
        },
        {
          "@type": "Question",
          "name": "Kell betétdíjat fizetni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ha a megrendelő nem rendelkezik saját csereballonnal, egyszeri betétdíj merülhet fel. A hivatalos weboldal az ellenőrzéskor 3 500 Ft bruttó betétdíjat közölt."
          }
        },
        {
          "@type": "Question",
          "name": "Mi a minimum házhozszállítási rendelés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A részletes forrásanyag standard minimumként 4 darab 19 literes ballont jelöl."
          }
        },
        {
          "@type": "Question",
          "name": "Négy ballontól ingyenes a szállítás?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás részletes forrása négy ballontól díjmentes szállítást közöl, a hivatalos szoboszloiviz.hu pedig ezt kifejezetten Hajdúszoboszlón belül emeli ki. Más településnél az aktuális feltételt érdemes megerősíteni."
          }
        },
        {
          "@type": "Question",
          "name": "Mennyi idő alatt érkezhet meg a rendelés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A szolgáltatási leírás szerint a rendelések jellemzően 24 órán belül teljesíthetők, a 10:00 előtt leadott rendeléseket pedig általában a következő munkanapra szervezik. Ez az útvonaltól és kapacitástól függ."
          }
        },
        {
          "@type": "Question",
          "name": "Vállalnak emeletre szállítást?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A rendelkezésre bocsátott forrásanyag szerint igen, lift nélküli épületben is vállalhatják a ballon feljuttatását; az emeletet és a megközelítést rendeléskor érdemes jelezni."
          }
        },
        {
          "@type": "Question",
          "name": "Lehet vízadagolót bérelni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A forrásanyag havi díjas vízadagoló-bérlést, karbantartási hátteret és szükség esetén cseregépet is megnevez."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen vízadagolókat lehet vásárolni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A kínálatban pumpás, asztali, álló, hideg-meleg és kompresszoros megoldások szerepelnek; a forrásanyag prémium, szénsavas funkciójú lehetőségeket is említ."
          }
        },
        {
          "@type": "Question",
          "name": "Meddig használható egy ballon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás termékadata szerint megfelelő állapot mellett körülbelül 40–60 újratöltési cikluson keresztül használható; sérült ballon esetén kivonják a forgalomból."
          }
        },
        {
          "@type": "Question",
          "name": "Meddig tárolható a víz?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A részletes forrás szerint bontatlanul, napfénytől védett helyen akár 8 hónapig, felbontás után pedig 3 héten belüli fogyasztást javasolnak. Mindig az aktuális csomagolási vagy közvetlen szolgáltatói tájékoztatás az elsődleges."
          }
        },
        {
          "@type": "Question",
          "name": "Hol szállítanak?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Elsősorban Hajdúszoboszló, Debrecen és Hajdú-Bihar vármegye területén. További kelet-magyarországi címek az útvonaltól és a rendelési feltételektől függően, előzetes egyeztetéssel jöhetnek szóba."
          }
        },
        {
          "@type": "Question",
          "name": "Hogyan lehet rendelni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Google üzleti rekord és a részletes szolgáltatási forrás a +36 30 974 3662 telefonszámot jelöli rendelési elérhetőségként. A szoboszloiviz.hu jelenleg a +36 70 281 2525 telefonszámot és az iroda@szoboszloiviz.hu címet is feltünteti."
          }
        }
      ]
    },
