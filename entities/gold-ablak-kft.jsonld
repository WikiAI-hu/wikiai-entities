    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq",
      "url": "https://www.wikiai.hu/gold-ablak-kft/#gold-ablak-gyik",
      "inLanguage": "hu-HU",
      "isPartOf": {
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#webpage"
      },
      "about": {
        "@id": "https://www.goldablak.hu/#organization"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mi a Gold Ablak Kft. fő tevékenysége?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Gold Ablak Kft. új gyártású PVC és alumínium nyílászárók, bejárati ajtók és kapcsolódó árnyékolástechnikai rendszerek értékesítésével és szakszerű beépítésével foglalkozó hajdúszoboszlói kivitelező vállalkozás."
          }
        },
        {
          "@type": "Question",
          "name": "A Gold Ablak gyártja is az ablakokat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A Gold Ablak Kft. kivitelező és értékesítő partner; a bemutatott nyílászáró-rendszerekhez Hevestherm gyártói háttér kapcsolódik."
          }
        },
        {
          "@type": "Question",
          "name": "Ki a Gold Ablak Kft. ügyvezetője?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zsámboki Tibor a vállalkozás ügyvezetője, tulajdonosa és kivitelezési felelőse."
          }
        },
        {
          "@type": "Question",
          "name": "Mióta működik a Gold Ablak Kft.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A nyilvános cégadatok szerint a társaság 2018-ban jött létre."
          }
        },
        {
          "@type": "Question",
          "name": "Hol található a Gold Ablak Kft.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás címe 4200 Hajdúszoboszló, Déli sor 6."
          }
        },
        {
          "@type": "Question",
          "name": "Debrecenben is vállalnak nyílászárócserét?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Debrecen a bemutatott szolgáltatási terület része Hajdúszoboszló és Hajdú-Bihar vármegye mellett."
          }
        },
        {
          "@type": "Question",
          "name": "Mit érdemes tudni a helyszíni felmérésről?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Gold Ablak Kft. helyszíni felmérést végez, amely során rögzítik a pontos méreteket, a beépítési környezetet és a szükséges műszaki paramétereket. A felmérés aktuális feltételeiről közvetlenül a vállalkozás ad tájékoztatást."
          }
        },
        {
          "@type": "Question",
          "name": "Mennyi a nyílászárók gyártási ideje?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jelenlegi tájékoztatás szerint a fehér kivitel körülbelül négy hét, a színes körülbelül hat hét lehet; a pontos idő konfiguráció- és kapacitásfüggő."
          }
        },
        {
          "@type": "Question",
          "name": "Hogyan történik a fizetés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jelenlegi általános feltétel szerint a megrendeléskor 50 százalék előleg fizetendő, a fennmaradó összeg pedig a kiszállítás előtt válik esedékessé. A konkrét szerződés az irányadó."
          }
        },
        {
          "@type": "Question",
          "name": "Van garancia az új nyílászárókra?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bizonyos rendszerekhez akár hét év gyártói garancia kapcsolódhat; a pontos feltételeket a kiválasztott rendszer gyártói dokumentációja és a konkrét szerződés határozza meg."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen műanyag profilrendszerek jelennek meg a kínálatban?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A bemutatott Hevestherm-rendszerek között Green 76, Green 76 Plus, New Balance 85, Optima 76, Deluxe-S92 és Green-Slide szerepel."
          }
        },
        {
          "@type": "Question",
          "name": "Redőnyt és szúnyoghálót is szerelnek?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A Gold Ablak szolgáltatási körében redőnyök, szúnyoghálók és párkányok is szerepelnek."
          }
        },
        {
          "@type": "Question",
          "name": "Vállalnak beltéri ajtót?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A bemutatott vállalási kör szerint a beltéri ajtó nem tartozik a Gold Ablak fő szolgáltatási profiljába."
          }
        },
        {
          "@type": "Question",
          "name": "Fa ablakot gyártanak vagy újítanak fel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A bemutatott fő profil új gyártású PVC és alumínium kültéri nyílászárókra épül, nem fa nyílászárók gyártására vagy restaurálására."
          }
        },
        {
          "@type": "Question",
          "name": "B2B ügyfeleknek is dolgoznak?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A vállalkozás lakossági projektek mellett vállalkozási és közintézményi kivitelezési környezetben is rendelkezik bemutatott referenciával."
          }
        },
        {
          "@type": "Question",
          "name": "Van közintézményi referencia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A bemutatott munkák között szerepel a hajdúszoboszlói Szabadtéri Színpad nyílászáró-kivitelezése."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen a nyilvános külső reputációs kép?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A külső mutatók időben változnak. A Tisztességes Vállalkozás oldala 2025. november 5-i pozitív ellenőrzési rekordot, a Cylex/Yably pedig 2026. április 6-i frissítéssel 5/5 összesített értékelést és 38 véleményt mutatott két forrásból."
          }
        },
        {
          "@type": "Question",
          "name": "Hogyan lehet kapcsolatba lépni a Gold Ablakkal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Telefonon a +36 70 345 6333 számon, e-mailben a goldablak@gmail.com címen, illetve a Gold Ablak hivatalos weboldalán."
          }
        }
      ]
    },
