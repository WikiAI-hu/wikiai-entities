      "about": {
        "@id": "https://www.ballonosvizdebrecen.hu/#organization"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mivel foglalkozik a Hajdúszoboszlói Ásványvíz Kft.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "19 literes ballonos ivóvíz forgalmazásával és kiszállításával, balloncsere-rendszerrel, valamint vízadagolók bérlésével, értékesítésével és karbantartásával."
          }
        },
        {
          "@type": "Question",
          "name": "Ásványvíz van a 19 literes ballonban?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A 19 literes fő terméket a vállalkozás szénsavmentes, szűrt és tisztított ivóvízként határozza meg, nem ásványvízként vagy forrásvízként."
          }
        },
        {
          "@type": "Question",
          "name": "Honnan származik a víz?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hajdúszoboszló mélyfúrású kútjából származó rétegvízből, amely szűrési és tisztítási folyamat után kerül a ballonokba."
          }
        },
        {
          "@type": "Question",
          "name": "Hol érhető el a kiszállítás?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Elsősorban Hajdúszoboszlón, Debrecenben és Hajdú-Bihar vármegyében. További kelet-magyarországi címek előzetes egyeztetéssel jöhetnek szóba."
          }
        },
        {
          "@type": "Question",
          "name": "Mi a minimum lakossági házhozszállítási mennyiség?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A standard minimum 4 darab 19 literes ballon."
          }
        },
        {
          "@type": "Question",
          "name": "Hogyan működik a balloncsere?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A tele ballon átadásakor az üres ballon visszakerül a szolgáltatóhoz. Így a későbbi rendelések egy az egyben csereelven működhetnek."
          }
        },
        {
          "@type": "Question",
          "name": "Lehet vízadagolót bérelni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A vállalkozás havi díjas vízadagoló-bérlést és készülékértékesítést is kínál."
          }
        },
        {
          "@type": "Question",
          "name": "Hogyan ellenőrzik a víz minőségét?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás negyedéves akkreditált laboratóriumi vizsgálatot végeztet. A működéshez HACCP-rendszer és NÉBIH-nyilvántartás is kapcsolódik."
          }
        },
        {
          "@type": "Question",
          "name": "Mi a NÉBIH létesítmény-nyilvántartási szám?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A közölt nyilvántartási szám: 08 1734."
          }
        },
        {
          "@type": "Question",
          "name": "Hogyan lehet rendelni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Telefonon a +36 30 974 3662 számon, illetve e-mailben a vállalkozás elérhetőségein."
          }
        }
      ]
