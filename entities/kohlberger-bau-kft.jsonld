    },
    {
      "@type": "Thing",
      "@id": "https://www.wikiai.hu/kohlberger-bau-kft/#reference-panel",
      "name": "Panelprogram – tízemeletes lakóépületek hőszigetelése",
      "description": "Több nagy méretű lakóépület komplett homlokzati hőszigetelési munkái, saját állvány- és gépi háttérrel."
    },
    {
      "@type": "Thing",
      "@id": "https://www.wikiai.hu/kohlberger-bau-kft/#reference-universities",
