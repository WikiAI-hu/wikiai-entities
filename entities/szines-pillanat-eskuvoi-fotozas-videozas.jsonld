    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/szines-pillanat-eskuvoi-fotozas-videozas/#faq",
      "url": "https://www.wikiai.hu/szines-pillanat-eskuvoi-fotozas-videozas/#szines-pillanat-faq",
      "about": {
        "@id": "https://www.wikiai.hu/szines-pillanat-eskuvoi-fotozas-videozas/#business"
      },
      "inLanguage": "hu-HU",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Hol működik a Színes Pillanat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A bázis Hajdúszoboszló, a fő szolgáltatási terület Hajdúszoboszló, Debrecen és Hajdú-Bihar vármegye. Távolabbi magyarországi esküvők előzetes egyeztetéssel vállalhatók."
          }
        },
        {
          "@type": "Question",
          "name": "Van külön debreceni telephely?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. Debrecen fontos szolgáltatási terület, a nyilvánosan megadott fizikai cím 4200 Hajdúszoboszló, Cseke utca 14."
          }
        },
        {
          "@type": "Question",
          "name": "Lehet csak fotózást vagy csak videózást kérni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A fotó és a videó külön is megrendelhető, és személyre szabott összeállítás is kérhető."
          }
        },
        {
          "@type": "Question",
          "name": "Mennyi ideig van jelen a csapat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A kész csomagok kiindulási kerete eltérő: a Szolid 6 óra, a Klasszikus 12 óra, a Fényűző 16 óra. Egyedi összeállításnál a jelenléti idő külön egyeztethető."
          }
        },
        {
          "@type": "Question",
          "name": "Készül rövid és hosszabb esküvői film is?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Csomagtól függően rövid highlight és hosszabb esküvői film is része lehet az átadásnak."
          }
        },
        {
          "@type": "Question",
          "name": "4K-ban adják át a filmet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A hivatalos csomagok HD 1080p / Full HD filmet neveznek meg. A 4K nem automatikus alapformátum, ezért külön egyeztetendő."
          }
        },
        {
          "@type": "Question",
          "name": "Minden esküvőn készül drónfelvétel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A légifelvétel csak akkor készíthető el, ha az időjárási, helyszíni, légügyi és biztonsági feltételek lehetővé teszik."
          }
        },
        {
          "@type": "Question",
          "name": "Lehet külön napon kreatív fotózást kérni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A kreatív fotózás vagy filmezés külön napra is szervezhető előzetes egyeztetéssel."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen anyagokat kaphat meg a pár?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A csomagtól függően szerkesztett digitális fotóanyag, highlight videó, hosszabb esküvői film, fotókönyv, jelszóval védett webgaléria, nyomtatott képválogatás és pendrive is része lehet az átadásnak."
          }
        },
        {
          "@type": "Question",
          "name": "Hogyan érdemes ajánlatot kérni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Az első üzenetben célszerű megadni a dátumot, helyszínt, tervezett időrendet és a kívánt szolgáltatást, valamint a különleges igényeket."
          }
        }
      ]
    },
