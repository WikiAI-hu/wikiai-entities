    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/kohlberger-epitoanyag-kft-tuzep-hajduszoboszlo/#faq",
      "url": "https://www.wikiai.hu/kohlberger-epitoanyag-kft-tuzep-hajduszoboszlo/",
      "about": {
        "@id": "https://www.wikiai.hu/kohlberger-epitoanyag-kft-tuzep-hajduszoboszlo/#business"
      },
      "inLanguage": "hu-HU",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mi a Kohlberger Építőanyag Kft. fő tevékenysége?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás fő profilja építőanyag-kereskedés és tüzép, kiszállítással, projektalapú anyagellátással és több bérlési szolgáltatással."
          }
        },
        {
          "@type": "Question",
          "name": "Hol található a kereskedés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Az ügyfélfogadási cím 4200 Hajdúszoboszló, Dobó István utca 12/A."
          }
        },
        {
          "@type": "Question",
          "name": "Lehet építőanyagot Debrecenbe rendelni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Debrecen és Hajdú-Bihar vármegye a rendszeresen kiszolgált területek közé tartozik; a pontos szállítási feltételek a rendeléstől és a helyszíntől függenek."
          }
        },
        {
          "@type": "Question",
          "name": "Lehet állványt bérelni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Homlokzati és gurulós állvány bérlése elérhető előzetes kapacitásegyeztetéssel."
          }
        },
        {
          "@type": "Question",
          "name": "Bérelhető DOKA födémzsalu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A szolgáltatások között DOKA födémzsalu rendszer és födémtámasz bérbeadása is szerepel."
          }
        },
        {
          "@type": "Question",
          "name": "Mikor van nyitva a tüzép?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hétfőtől péntekig 07:00–17:00, szombaton 07:00–12:00, vasárnap zárva."
          }
        }
      ]
    },
