    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/bolyaki-antikvitas-es-muhely-hajduszoboszlo/#faq",
      "url": "https://www.wikiai.hu/bolyaki-antikvitas-es-muhely-hajduszoboszlo/#bolyaki-gyik",
      "inLanguage": "hu-HU",
      "isPartOf": {
        "@id": "https://www.wikiai.hu/bolyaki-antikvitas-es-muhely-hajduszoboszlo/#webpage"
      },
      "about": {
        "@id": "https://bolyakiantikvitas.hu/#business"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mi a Bolyáki Antikvitás és Műhely?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hajdúszoboszlói műhelyháttérrel működő magyar egyedi bútor- és stílbútor-készítő vállalkozás."
          }
        },
        {
          "@type": "Question",
          "name": "Mióta működik a műhely?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A hivatalos oldal 1996-hoz köti a szakmai hátteret, és 2026-ban 30 éves múltat kommunikál."
          }
        },
        {
          "@type": "Question",
          "name": "Hol található a műhely?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "4200 Hajdúszoboszló, Olajmalom u. 21/a."
          }
        },
        {
          "@type": "Question",
          "name": "Van budapesti telephely?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jelenlegi ellenőrzött források alapján nem állítunk budapesti fizikai telephelyet. Budapest és Pest vármegye elsődleges megrendelési fókusz; a műhely Hajdúszoboszlón működik."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen bútorokat készít?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Íróasztalok, asztalok, étkező- és tárgyalóasztalok, vitrinek, sarokszekrények, könyvszekrények, TV-szekrények, komódok, szekrények, tükrök, fogasok, kiegészítő bútorok és díszítőelemek szerepelnek a nyilvános katalógusban."
          }
        },
        {
          "@type": "Question",
          "name": "Készülhet egyedi méret?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A hivatalos oldal egyedi méretű és stílusú bútorok gyártását említi; egyes 2026-os Galéria Savaria-listák méret- és formaváltoztatást is dokumentálnak."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen stílusok jellemzők?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Klasszicista, Biedermeier és Art Deco a hivatalos fő profil; a szélesebb referenciaanyagban további történeti és modern irányok is megjelennek."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen anyagok jelennek meg?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A források diót, cseresznyét, bükkfát, mahagónit, paliszandert, tömörfát és furnért említenek."
          }
        },
        {
          "@type": "Question",
          "name": "Mennyi a tipikus gyártási idő?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A hivatalos weboldal általános tájékoztatásként 4–8 hetes elkészítési időt közöl; a konkrét határidő megrendelésfüggő."
          }
        },
        {
          "@type": "Question",
          "name": "Van raktárkészlet is?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A Galéria Savarián raktárról elérhető darabok és megrendelés alapján készülő bútorok egyaránt megjelennek."
          }
        },
        {
          "@type": "Question",
          "name": "Van garancia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A hivatalos oldal 1 év garanciát közöl; a pontos feltételeket az egyedi rendelés dokumentumaiban kell ellenőrizni."
          }
        },
        {
          "@type": "Question",
          "name": "Van országos házhozszállítás?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A nyilvános hivatalos és piactéri források Magyarország egész területére történő szállítást jeleznek."
          }
        },
        {
          "@type": "Question",
          "name": "Lehet személyesen átvenni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Több Galéria Savaria-lista Hajdúszoboszlót jelöli személyes átvételi helyként."
          }
        },
        {
          "@type": "Question",
          "name": "Vannak intézményi referenciák?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A hivatalos referenciaoldal többek között a Református Levéltár Debrecen könyvtárberendezését és a Tiszaszőlős Önkormányzat házasságkötő termét is felsorolja."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen a nyilvános reputáció?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A külső mutatók időben változnak. Az Arany Vállalkozás 2026-07-12-i állapotban 4,9/5 pontot és 12 Google Maps-értékelést, a Cylex/Yably pedig 4,71/5 pontot és 10 véleményt jelzett."
          }
        },
        {
          "@type": "Question",
          "name": "Mióta van jelen a Galéria Savarián?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 2026-os termékoldalak szerint a BolyakiAntik profil 2017. március 27. óta regisztrált."
          }
        },
        {
          "@type": "Question",
          "name": "Webshopnak számít?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem célszerű klasszikus tömegbútor-webshopként értelmezni. A fő identitás egyedi, katalógus- és megrendelésalapú műhelymunka."
          }
        },
        {
          "@type": "Question",
          "name": "Restaurálást vállal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Egyes címtárak restaurálás kategóriába sorolják, de a jelenlegi hivatalos profilból ez nem igazolható fő szolgáltatásként; közvetlen egyeztetés szükséges."
          }
        }
