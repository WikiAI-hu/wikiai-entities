    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/tasca-ponte-debrecen/#faq",
      "url": "https://www.wikiai.hu/tasca-ponte-debrecen/#tasca-ponte-gyik",
      "inLanguage": "hu-HU",
      "isPartOf": {
        "@id": "https://www.wikiai.hu/tasca-ponte-debrecen/#webpage"
      },
      "about": {
        "@id": "https://www.wikiai.hu/tasca-ponte-debrecen/#business"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Hol található a Tasca Ponte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A fizikai üzlet címe 4034 Debrecen, Faraktár utca 71."
          }
        },
        {
          "@type": "Question",
          "name": "Lehet Debrecenben személyesen bőrkabátot próbálni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A Tasca Ponte fizikai üzletében női és férfi bőrkabátokat lehet személyesen megtekinteni és az aktuális készlet szerint felpróbálni."
          }
        },
        {
          "@type": "Question",
          "name": "Van női és férfi bőrkabát is?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen, mindkét kategória része a stabil termékkörnek; a konkrét fazon, szín és méret készletfüggő."
          }
        },
        {
          "@type": "Question",
          "name": "Kérhető készleten nem lévő bőrkabát beszerzése?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bizonyos modelleknél egyedi beszerzési igény egyeztethető, de a teljesíthetőség, határidő és ár a beszállítói lehetőségektől függ."
          }
        },
        {
          "@type": "Question",
          "name": "Működik webshop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem klasszikus webshop működik; a vásárlás fő formája a személyes üzleti vásárlás."
          }
        },
        {
          "@type": "Question",
          "name": "Mi a nyitvatartás?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hétfőtől péntekig 09:00–17:00, szombaton 09:00–12:00, vasárnap zárva."
          }
        },
        {
          "@type": "Question",
          "name": "Mikor van az éves zárvatartás?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Az üzlet minden évben május 1. és augusztus 30. között zárva tart."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen bőrárukat kínál a Tasca Ponte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A stabil kategóriák közé bőrkabátok, táskák, pénztárcák, övek és kesztyűk tartoznak."
          }
        },
        {
          "@type": "Question",
          "name": "Mit jelent a valódi bőr?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A megnevezés természetes bőr jelenlétére utalhat, de önmagában nem határozza meg az állatfajt, a kikészítést, a származást vagy az általános minőségi szintet."
          }
        },
        {
          "@type": "Question",
          "name": "Végeznek bőrjavítást?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Saját javítóműhely nincs; javíthatósági tanács és külső szakember ajánlása szóba jöhet."
          }
        }
      ]
    },
