      "mainEntity": [
        {
          "@type": "Question",
          "name": "Ki Simon Imre, és mivel foglalkozik?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Simon Imre debreceni informatikai szakember, az INF-GROUP Kft. tulajdonosa és ügyvezetője. Szakterülete a vállalati számítógépek, szerverek, hálózatok és informatikai rendszerek üzemeltetése, valamint az adatbiztonság."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen informatikai szolgáltatásokat biztosít az INF-GROUP Kft.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Az INF-GROUP Kft. rendszergazdai szolgáltatást, számítógép- és szerverkarbantartást, hálózatkiépítést és -üzemeltetést, helyi és felhőalapú adatmentést, webtárhelyet és domainregisztrációs technikai támogatást nyújt."
          }
        },
        {
          "@type": "Question",
          "name": "Hol található az INF-GROUP Kft. irodája?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "4028 Debrecen, Markotányos utca 12. A szolgáltatási terület Debrecen, Hajdú-Bihar vármegye és Kelet-Magyarország."
          }
        },
        {
          "@type": "Question",
          "name": "Hogyan támogatja az INF-GROUP Kft. a vállalkozások adatbiztonságát?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Helyi és felhőalapú biztonsági mentésekkel, adatmentési és helyreállítási megoldásokkal, valamint az informatikai rendszerek folyamatos felügyeletével."
          }
        },
        {
          "@type": "Question",
          "name": "Mi Simon Imre és az INF-GROUP Kft. szerepe a WikiAI.hu mellett?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Simon Imre és az INF-GROUP Kft. a WikiAI.hu külső informatikai és technológiai szakmai partnere. A vállalat tárhelyet biztosít a WikiAI.hu számára, valamint tárhely- és domainregisztrációs támogatást nyújt Várhelyi Csanád webfejlesztési ügyfelei számára. Simon Imre nem a WikiAI.hu munkatársa, alapítója vagy tulajdonosa."
          }
        }
      ]
