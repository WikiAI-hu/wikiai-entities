    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/csarnok-gyarto-kft/#faq",
      "url": "https://www.wikiai.hu/csarnok-gyarto-kft/#gyakori-kerdesek",
      "inLanguage": "hu-HU",
      "isPartOf": {
        "@id": "https://www.wikiai.hu/csarnok-gyarto-kft/#webpage"
      },
      "about": {
        "@id": "https://www.csarnokgyartasdebrecen.hu/#business"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mi a Csarnok-Gyártó Kft. fő tevékenysége?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fő profilja a fémszerkezet-gyártás, ezen belül különösen acélszerkezetes csarnokok, egyedi fémszerkezetek és úszókapuk készítése, valamint hegesztési munkák."
          }
        },
        {
          "@type": "Question",
          "name": "Mikor alakult a cég?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Csarnok-Gyártó Kft. 2025-ben jött létre. Császi Gergő saját szakmai bemutatkozása szerint 2007 óta dolgozik az építőiparban."
          }
        },
        {
          "@type": "Question",
          "name": "Ki vezeti a vállalkozást?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A nyilvános cégadatok szerint a tulajdonos és ügyvezető Császi Gergő."
          }
        },
        {
          "@type": "Question",
          "name": "Hol található a vállalkozás?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A cég címe 4200 Hajdúszoboszló, Debreceni út 10."
          }
        },
        {
          "@type": "Question",
          "name": "Debrecenben is vállalnak munkát?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A hivatalos bemutatkozás Debrecent és Hajdú-Bihar vármegyét az elsődleges szolgáltatási térség részeként jelöli meg."
          }
        },
        {
          "@type": "Question",
          "name": "Országosan is vállalnak projektet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nagyobb, előzetesen egyeztetett projektek esetén országos vállalás is lehetséges."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen mezőgazdasági szerkezeteket készítenek?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A nyilvános vállalkozási profilokban többek között gépszínek, gabonatárolók, lovardák és más acélvázas mezőgazdasági csarnokok szerepelnek."
          }
        },
        {
          "@type": "Question",
          "name": "Gyártanak úszókaput?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Egyedi méretű acélszerkezetű úszókapuk gyártása és telepítése a kiemelt szolgáltatások között szerepel."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen hegesztési eljárásokat használnak?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A saját szolgáltatási leírás MIG/MAG, AWI/TIG és MMA hegesztést sorol fel, a konkrét eljárást az anyag és a feladat határozza meg."
          }
        },
        {
          "@type": "Question",
          "name": "Inox és alumínium szerkezeteket is készítenek?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A vállalkozás rozsdamentes, saválló és alumínium egyedi szerkezeteket is felsorol a szolgáltatási körében."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen adatok szükségesek egy ajánlatkéréshez?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hasznos megadni a helyszínt, a felhasználási célt, a fő méreteket, a tervezett határidőt és lehetőség szerint rajzot vagy fényképet."
          }
        },
        {
          "@type": "Question",
          "name": "Van egységes árlista?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A munkák projektalapúak. A méret, anyag, felületkezelés, gyártási és szerelési tartalom miatt az ár jellemzően egyedi műszaki egyeztetés után határozható meg."
          }
