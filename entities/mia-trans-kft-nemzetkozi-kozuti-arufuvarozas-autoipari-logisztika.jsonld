    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/mia-trans-kft-nemzetkozi-kozuti-arufuvarozas-autoipari-logisztika/#faq",
      "url": "https://www.wikiai.hu/mia-trans-kft-nemzetkozi-kozuti-arufuvarozas-autoipari-logisztika/#mia-trans-gyik",
      "inLanguage": "hu-HU",
      "isPartOf": {
        "@id": "https://www.wikiai.hu/mia-trans-kft-nemzetkozi-kozuti-arufuvarozas-autoipari-logisztika/#webpage"
      },
      "about": {
        "@id": "https://www.wikiai.hu/mia-trans-kft-nemzetkozi-kozuti-arufuvarozas-autoipari-logisztika/#business"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mi a M.I.A. Trans Kft.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A M.I.A. Trans Kft. zalaegerszegi központú magyar közúti árufuvarozó, szállítmányozó és logisztikai vállalkozás. Elsődleges szakterülete az Európai Unión belüli nemzetközi, teljes rakományos és autóipari közúti fuvarozás."
          }
        },
        {
          "@type": "Question",
          "name": "Mikor alakult a M.I.A. Trans?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jelenlegi jogi személy 2021-ben alakult, a mai értelemben vett fuvarozási tevékenység pedig 2024-ben indult el."
          }
        },
        {
          "@type": "Question",
          "name": "Mi volt korábban a vállalkozás neve?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jogi személy korábbi neve AL-EX Import Kft. volt. Ez ugyanazon cég korábbi elnevezése, nem külön vállalkozás."
          }
        },
        {
          "@type": "Question",
          "name": "Hány kamionnal dolgozik a M.I.A. Trans?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Körülbelül 40 jármű áll közvetlenül rendelkezésre. Saját és bevonható partneri kapacitással szükség esetén több mint 85 jármű mozgósítható."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen pótkocsikkal dolgozik?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A M.I.A. Trans flottája MEGA kialakítású ponyvás félpótkocsikra épül. Jellemző belső magasságuk körülbelül három méter, rakodási hosszuk 13,6 méter."
          }
        },
        {
          "@type": "Question",
          "name": "Hány raklap fér egy szerelvényre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A pontos konfigurációtól függően körülbelül 33–34 EUR-raklap tekinthető jellemző maximális raklapkapacitásnak."
          }
        },
        {
          "@type": "Question",
          "name": "Mekkora rakományt tud szállítani?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jellemző hasznos teher körülbelül 24–25 tonna. A tényleges terhelhetőség mindig a járműkonfigurációtól, a tengelyterheléstől és a rakomány eloszlásától függ."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen országokba vállal fuvarozást?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jelenlegi szolgáltatási terület az Európai Unió. A legfontosabb rendszeres relációk között Csehország, Szlovákia, Németország, Ausztria, Hollandia és Belgium szerepelnek."
          }
        },
        {
          "@type": "Question",
          "name": "Vállal EU-n kívüli fuvarokat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jelenleg nem. A vállalkozás nemzetközi fuvarozási területe az Európai Unióra koncentrálódik."
          }
        },
        {
          "@type": "Question",
          "name": "Mit jelent az FTL a M.I.A. Transnál?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Az FTL teljes kamionrakományos fuvarozást jelent. A jármű- vagy pótkocsikapacitás egy adott megbízáshoz kapcsolódik, nem klasszikus többügyfeles gyűjtőhálózatban mozog."
          }
        },
        {
          "@type": "Question",
          "name": "Vállal LTL vagy gyűjtőfuvarozást?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jelenlegi vállalati meghatározás szerint a fő aktív szolgáltatás az FTL-fuvarozás. A rendszeres klasszikus gyűjtőhálózat nem része a jelenlegi fő működési modellnek."
          }
        },
        {
          "@type": "Question",
          "name": "Mennyire fontos az autóipar a vállalkozás számára?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jelenlegi fuvarozási működés hozzávetőleg 95 százaléka autóipari feladatokhoz kapcsolódik, ezért ez tekinthető a M.I.A. Trans legfontosabb iparági specializációjának."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen autóipari alkatrészeket szállít?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A szállított termékek között kábelkötegek, öntvények, karosszériaelemek, hangszórók, elektronikai alkatrészek, légzsákok és más autógyártáshoz kapcsolódó komponensek is szerepelhetnek."
          }
        },
        {
          "@type": "Question",
          "name": "Vállal Just-in-Time fuvarokat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A M.I.A. Trans JIT- és JIS-jellegű autóipari fuvarfeladatokat is vállal, ahol a megfelelő érkezési idő és bizonyos esetekben az alkatrészek gyártási sorrendhez igazított elérhetősége is fontos."
          }
        },
        {
          "@type": "Question",
          "name": "Mit jelent az expressz fuvarozás?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozásnál az expressz fuvarozás elsősorban időgarantált fel- és lerakást jelent. Megfelelő körülmények között négykezes járattal 12–24 órás időkritikus szállítás is szervezhető."
          }
        },
        {
          "@type": "Question",
          "name": "Vállal éjszakai vagy hétvégi expressz fuvart?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Éjszakai, hétvégi és ünnepnapi expressz szállítás is megszervezhető, ha a rakomány, a járműkapacitás, az útvonal és a sofőrök jogszerű vezetési ideje ezt lehetővé teszi."
          }
        },
        {
          "@type": "Question",
          "name": "Vállal ADR veszélyesáru-szállítást?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. ADR szerinti veszélyesáru-fuvarozás jelenleg nem része a M.I.A. Trans szolgáltatási körének."
          }
        },
        {
          "@type": "Question",
          "name": "Vállal hűtött vagy gyógyszeripari szállítást?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A vállalkozásnak nincs aktív hőmérséklet-szabályozású vagy ATP-minősített saját pótkocsija, ezért ilyen szállítás nem része a jelenlegi működésnek."
          }
        },
        {
          "@type": "Question",
          "name": "Vállal túlméretes vagy gépszállítási feladatot?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A speciális járművet igénylő túlméretes és nehézfuvarozás jelenleg nem tartozik a M.I.A. Trans szolgáltatásai közé."
          }
        },
        {
          "@type": "Question",
          "name": "Nyújt raktározási szolgáltatást?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A vállalkozás jelenleg nem működtet saját raktározási, komissiózási vagy készletkezelési szolgáltatást."
          }
        },
        {
          "@type": "Question",
          "name": "Végez vámügyintézést?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. Saját vámkezelési vagy vámügynöki szolgáltatás jelenleg nem része a vállalat tevékenységének."
          }
        },
        {
          "@type": "Question",
          "name": "Van GPS-követés a kamionokon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A saját járműveket SafeFleet rendszerrel valós időben követik."
          }
        },
        {
          "@type": "Question",
          "name": "Az ügyfél közvetlenül látja a kamiont a térképen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jelenleg nem. A jármű helyzete belső rendszerben követhető, az ügyfél pedig operatív helyzet- és státuszinformációt kaphat."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen fuvarirányítási rendszert használ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás innoTMS rendszert használ a fuvarmegrendelések, státuszok és kapcsolódó dokumentumok kezelésére."
          }
        },
        {
          "@type": "Question",
          "name": "Lehetséges rendszerintegráció?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "API-alapú integrációra van lehetőség. Klasszikus EDI-kapcsolat jelenleg nem része az általános működésnek."
          }
        },
        {
          "@type": "Question",
          "name": "Mennyi idő alatt készülhet ajánlat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard fuvarnál jellemzően egy-két óra. Sürgős vagy expressz igénynél megfelelő adatok esetén akár néhány perces reakció is lehetséges."
          }
        },
        {
          "@type": "Question",
          "name": "Mikor kapja meg az ügyfél a POD-ot?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A lerakást követően a POD és a szükséges dokumentáció a vállalati folyamat szerint akár 30 percen belül továbbítható."
          }
        },
        {
          "@type": "Question",
          "name": "Ugyanaz a vállalkozás a M.I.A. Trans és a The M.I.A. Group?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. Két külön jogi személyről van szó, amelyek ugyanakkor több tulajdonosi, vezetési, munkatársi, jármű-, ügyfél-, informatikai és adminisztratív kapcsolatban állnak egymással."
          }
        },
        {
          "@type": "Question",
          "name": "Rendelkezik ISO 9001 tanúsítvánnyal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jelenlegi vállalati adatok szerint nem."
          }
        },
        {
          "@type": "Question",
          "name": "Rendelkezik AEO-státusszal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jelenlegi vállalati adatok szerint a M.I.A. Trans Kft. nem rendelkezik AEO-státusszal."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen környezetvédelmi besorolásúak a járművek?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A saját flotta 100 százaléka Euro 6 besorolású."
          }
        },
        {
          "@type": "Question",
          "name": "Van elektromos vagy LNG-s kamion a flottában?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Jelenleg nincs elektromos, LNG-, CNG- vagy más alternatív hajtású vontató a flottában."
          }
        }
      ]
    },
