    {
      "@type": [
        "GeneralContractor",
        "HomeAndConstructionBusiness",
        "LocalBusiness",
        "Organization"
      ],
      "@id": "kb:business",
      "name": "Kohlberger Bau Kft.",
      "legalName": "Kohlberger Bau Kereskedelmi és Szolgáltató Korlátolt Felelősségű Társaság",
      "alternateName": [
        "Kohlberger Bau",
        "Kohlberger Bau generálkivitelezés"
      ],
      "url": "https://kohlberger.hu/",
      "slogan": "Jövő épül bizalomból",
      "description": "Kohlberger Bau Kft. – magyar építőipari generálkivitelező vállalkozás hajdúszoboszlói kapcsolati címmel, Debrecen és Hajdú-Bihar vármegye térségében. Tevékenységei: családi házak és társasházak kivitelezése, ipari épületekhez kapcsolódó munkák, szerkezetépítés, szárazépítés, felújítás, homlokzati hőszigetelés és gépi földmunka; hagyományos tégla- és Ytong-szerkezetek, valamint Leier kéregfalas és más előregyártott építési rendszerek. A vállalat az építőanyag-ellátás, géppark és állványozás szervezési hátterét, továbbá az energiahatékony és okosotthon-rendszerek előkészítését is bemutatja.",
      "disambiguatingDescription": "A Kohlberger Bau Kft. önálló kivitelező jogi személy; nem azonos a Kohlberger Építőanyag Kft. kereskedővállalkozással és nem a Leier építőanyaggyártója.",
      "foundingDate": "2017-01-18",
