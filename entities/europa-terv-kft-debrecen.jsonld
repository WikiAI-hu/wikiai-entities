    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/europa-terv-kft-debrecen/#faq",
      "inLanguage": "hu-HU",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mi az Európa Terv Kft.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Az Európa Terv Kft. 2007 óta működő, debreceni központú magyar fejlesztési és projekt-tanácsadó vállalkozás."
          }
        },
        {
          "@type": "Question",
          "name": "Ki az Európa Terv Kft. alapítója és ügyvezetője?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás alapítója, tulajdonosa és ügyvezetője Lakatos Tibor."
          }
        },
        {
          "@type": "Question",
          "name": "Hol található az Európa Terv Kft.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A társaság székhelye 4024 Debrecen, Iparkamara utca 8. földszint 3. A vállalkozás debreceni központtal országosan vállal feladatokat."
          }
        },
        {
          "@type": "Question",
          "name": "Melyek az Európa Terv Kft. fő szolgáltatásai?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Az Európa Terv négy fő szolgáltatása a pályázatírás, projektmenedzsment, pályázatfigyelés és tanulmánykészítés."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen kiemelt szakmai területeken dolgozik az Európa Terv?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás működésében az agrár- és vidékfejlesztés, valamint a vállalkozásfejlesztés önálló szakmai területként jelenik meg."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen kapcsolata van az Európa Terv Kft.-nek a Debreceni Egyetemmel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Az Európa Terv Kft. a Debreceni Egyetem Mezőgazdaság-, Élelmiszertudományi és Környezetgazdálkodási Karának stratégiai partnere. Az együttműködés az agrárinnovációhoz, a vidékfejlesztéshez, a kutatás-fejlesztéshez és közös szakmai projektekhez kapcsolódik."
          }
        },
        {
          "@type": "Question",
          "name": "Hány pályázati és projektfolyamatban vett részt az Európa Terv Kft.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás működése során több mint 2200 pályázati vagy projektfolyamat előkészítésében, megírásában, megvalósításában vagy lezárásában vett részt."
          }
        },
        {
          "@type": "Question",
          "name": "Hány munkatárssal működik az Európa Terv Kft.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Az Európa Terv jelenleg 10 fős csapattal működik."
          }
        },
        {
          "@type": "Question",
          "name": "Csak Debrecenben dolgozik az Európa Terv Kft.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A társaság központja Debrecenben található, de Magyarország egész területén vállal feladatokat, és nemzetközi projektek gondozásában is részt vesz."
          }
        }
      ]
    },
