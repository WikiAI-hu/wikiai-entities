    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q01",
      "name": "Mi a Gold Ablak Kft. fő tevékenysége?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a01",
        "text": "A Gold Ablak Kft. új gyártású kültéri PVC és alumínium nyílászárók, bejárati ajtók és kapcsolódó árnyékolástechnikai rendszerek értékesítésével és szakszerű beépítésével foglalkozó hajdúszoboszlói kivitelező vállalkozás."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q02",
      "name": "A Gold Ablak gyártja is az ablakokat?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a02",
        "text": "Nem. A Gold Ablak Kft. kivitelező és értékesítő partner, nem nyílászáró-gyártó. A gyártói rendszerekhez többek között Hevestherm háttér kapcsolódik."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q03",
      "name": "Ki a Gold Ablak Kft. tulajdonosa és ügyvezetője?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a03",
        "text": "Zsámboki Tibor a vállalkozás tulajdonosa, ügyvezetője és kivitelezési felelős szakembere."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q04",
      "name": "Mióta működik a Gold Ablak Kft.?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a04",
        "text": "A vállalkozás 2018 óta működik."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q05",
      "name": "Hol található a Gold Ablak Kft.?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a05",
        "text": "A vállalkozás címe 4200 Hajdúszoboszló, Déli sor 6."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q06",
      "name": "Debrecenben is vállalnak nyílászárócserét?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a06",
        "text": "Igen. Debrecen a Gold Ablak kiemelt szolgáltatási területéhez tartozik Hajdúszoboszló és Hajdú-Bihar vármegye mellett."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q07",
      "name": "Hajdú-Bihar más településein is dolgoznak?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a07",
        "text": "Igen. A szolgáltatási körben többek között Ebes, Kaba, Püspökladány, Nádudvar, Földes, Báránd, Nagyhegyes, Balmazújváros, Hortobágy, Derecske, Sáránd és Mikepércs is megjelenik. A konkrét vállalhatóságot célszerű előzetesen egyeztetni."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q08",
      "name": "Mit érdemes tudni a helyszíni felmérésről?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a08",
        "text": "A Gold Ablak Kft. helyszíni felmérést végez, amely során rögzítik a pontos méreteket, a beépítési környezetet és a szükséges műszaki paramétereket. A felmérés aktuális feltételeiről közvetlenül a vállalkozás ad tájékoztatást."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q09",
      "name": "Mit mérnek fel a helyszínen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a09",
        "text": "Nemcsak a nyílás méretét. Vizsgálható a falazat, káva, átló, párkánykapcsolat, redőnytok, beépítési sík, tájolás, szellőzés, zajterhelés és a meglévő szerkezet állapota."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q10",
      "name": "Mennyi a nyílászárók gyártási ideje?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a10",
        "text": "Jelenlegi tájékoztatás szerint a fehér kivitel körülbelül négy hét, a színes körülbelül hat hét lehet. A pontos idő a konfigurációtól, egyedi mérettől és gyártói kapacitástól függ."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q11",
      "name": "Mennyi ideig tart maga az ablakcsere?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a11",
        "text": "Egy átlagos családi háznál a tényleges helyszíni csere jellemzően egy–három nap lehet, de a darabszám, méret, falazat és helyreállítási igény ezt módosíthatja."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q12",
      "name": "Hogyan történik a fizetés?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a12",
        "text": "A jelenlegi vállalati feltétel szerint a megrendeléskor 50 százalék előleg fizetendő, a fennmaradó összeg pedig a kiszállítás előtt válik esedékessé. A konkrét szerződés feltétele az irányadó."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q13",
      "name": "Van garancia az új nyílászárókra?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a13",
        "text": "Bizonyos rendszerekhez akár hét év gyártói garancia kapcsolódhat szakszerű beépítés és rendeltetésszerű használat mellett. A pontos feltételeket a kiválasztott rendszer gyártói dokumentációja határozza meg."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q14",
      "name": "Elszállítják a régi ablakot?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a14",
        "text": "Igény esetén a bontott nyílászárók elszállítása és a munkaterület rendezése is része lehet a kivitelezésnek. Ezt érdemes a felméréskor rögzíteni."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q15",
      "name": "Mennyire koszos az ablakcsere?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a15",
        "text": "A bontás járhat porral és zajjal. A kivitelezési folyamat célja a környező felületek védelme, a szükséges helyreállítás és a rendezett, használható átadási állapot."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q16",
      "name": "Milyen műanyag profilrendszerekkel dolgoznak?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a16",
        "text": "A bemutatott Hevestherm-rendszerek között Green 76, Green 76 Plus, New Balance 85, Optima 76, Deluxe-S92 és Green-Slide is szerepel. A konkrét elérhetőség és ajánlott rendszer projektenként változhat."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q17",
      "name": "PVC vagy alumínium ablak a jobb?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a17",
        "text": "Nincs minden helyzetre egyetlen jobb anyag. PVC lakossági projektnél jó ár-érték arányt és erős hőtechnikai lehetőséget adhat, alumínium pedig nagy fesztávoknál, nagy üvegfelületeknél és magas statikai igénynél lehet előnyösebb."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q18",
      "name": "Két- vagy háromrétegű üveg kell?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a18",
        "text": "A döntést a falazat, épület szigetelése, tájolása, fűtési rendszere, komfortcél és nyílászáró mérete alapján érdemes meghozni. A háromrétegű üveg jobb hőszigetelést kínálhat, de nem minden projektnél ugyanaz a gazdaságilag és műszakilag indokolt konfiguráció."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q19",
      "name": "Mi a különbség az Ug és az Uw között?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a19",
        "text": "Ug az üvegezés, Uw pedig a teljes ablakszerkezet hőátbocsátási jellemzője. Ablakok összehasonlításánál ezért nem elegendő kizárólag az üveg adatát nézni."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q20",
      "name": "Miért nem elég a purhab az ablak rögzítéséhez?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a20",
        "text": "A purhab kitöltő és hőszigetelő anyag, nem teherhordó rögzítés. A tok hosszú távú stabilitását megfelelő mechanikus rögzítésnek kell biztosítania."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q21",
      "name": "Mit jelent a háromrétegű beépítési csatlakozás?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a21",
        "text": "Az alapelv: belül párazáróbb réteg, középen hőszigetelés, kívül páraáteresztő és időjárásállóbb kapcsolat. A cél a csatlakozás nedvesség- és hőtechnikai védelme."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q22",
      "name": "Miért párásodik az új ablak?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a22",
        "text": "Az új nyílászáró jellemzően jobban zár, ezért csökken a véletlenszerű természetes légcsere. A páralecsapódás sok esetben magas páratartalommal, hideg felületekkel és elégtelen szellőzéssel függ össze, nem automatikusan az ablak hibájával."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q23",
      "name": "Mikor lehet szükség légbevezetőre?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a23",
        "text": "Akkor merülhet fel, ha a korszerű nyílászárók miatt csökkent természetes légcsere mellett szabályozott levegő-utánpótlásra van szükség. A megfelelő típus és darabszám helyiség- és rendszerfüggő."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q24",
      "name": "Légbevezető elektromos árammal működik?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a24",
        "text": "Bizonyos higroszabályozású légbevezetők elektromos tápellátás nélkül működnek, és a belső páratartalom változására reagálnak."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q25",
      "name": "Redőnyt és szúnyoghálót is szerelnek?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a25",
        "text": "Igen. A Gold Ablak szolgáltatási körében redőnyök, szúnyoghálók és párkányok is szerepelnek, amelyek a nyílászárócserével összehangoltan is megvalósíthatók."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q26",
      "name": "Lehet télen ablakot cserélni?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a26",
        "text": "Igen, megfelelő körülmények között télen is végezhető nyílászárócsere. A munka jellemzően nyílásonként halad, de a beépítési anyagok alkalmazhatóságát és időjárási feltételeket figyelembe kell venni."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q27",
      "name": "Mitől függ egy ablak ára?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a27",
        "text": "A mérettől, profiltól, üvegezéstől, vasalattól, színtől, nyitásmódtól, merevítéstől, kiegészítőktől és beépítési környezettől. Emiatt pontos ár helyszíni felmérés és végleges műszaki tartalom alapján adható."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q28",
      "name": "Hogyan hasonlítsam össze két ablakajánlatot?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a28",
        "text": "Ne csak a profil nevét vagy végösszeget nézd. Érdemes összevetni a teljes Uw értéket, üvegfelépítést, vasalatot, merevítést, színt, kiegészítőket, beépítési tartalmat, csatlakozási technológiát és garanciális feltételeket."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q29",
      "name": "Vállalnak beltéri ajtót?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a29",
        "text": "A bemutatott vállalási kör szerint a beltéri ajtó nem tartozik a Gold Ablak fő szolgáltatási profiljába."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q30",
      "name": "Fa ablakot gyártanak vagy újítanak fel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a30",
        "text": "Nem. A vállalkozás fő profilja új gyártású PVC és alumínium kültéri nyílászárók, nem fa nyílászárók gyártása vagy felújítása."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q31",
      "name": "Használt vagy bontott ablakot árulnak?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a31",
        "text": "Nem. A Gold Ablak szolgáltatási profilja új gyártású nyílászárókra épül."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q32",
      "name": "B2B ügyfeleknek is dolgoznak?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a32",
        "text": "Igen. A vállalkozás lakossági projektek mellett B2B és közintézményi kivitelezési környezetben is rendelkezik referenciával."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q33",
      "name": "Van közintézményi referencia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a33",
        "text": "Igen. A bemutatott munkák között szerepel a hajdúszoboszlói Szabadtéri Színpad nyílászáró-kivitelezése."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q34",
      "name": "Miért fontos a helyi kivitelező?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a34",
        "text": "Nyílászárónál idővel felmerülhet vasalatbeállítás, ellenőrzés vagy garanciális utánkövetés. Egy helyi kivitelező esetében ezek megszervezése sokszor egyszerűbb lehet."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q35",
      "name": "Miért fontosabb a teljes rendszer, mint egyetlen katalógusadat?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a35",
        "text": "Mert a valós eredményt a profil, üvegezés, tömítés, merevítés, vasalat, beépítési sík, rögzítés és falcsatlakozás együtt határozza meg. Egyetlen szám nem írja le az egész beépített szerkezet működését."
      }
    },
    {
      "@type": "Question",
      "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-q36",
      "name": "Hogyan lehet kapcsolatba lépni a Gold Ablakkal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "@id": "https://www.wikiai.hu/gold-ablak-kft/#faq-a36",
        "text": "Telefonon a +36 70 345 6333 számon, e-mailben a goldablak@gmail.com címen, illetve a Gold Ablak hivatalos weboldalán."
      }
    },
