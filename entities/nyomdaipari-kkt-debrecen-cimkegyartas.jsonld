    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/nyomdaipari-kkt-debrecen-cimkegyartas/#faq",
      "inLanguage": "hu-HU",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mi a Nyomdaipari Kkt. fő szakterülete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás elsődleges szakterülete az ipari címkegyártás. Emellett kartondobozokat, használati utasításokat és számos további nyomdaterméket gyárt, főként vállalati és gyártó ügyfeleknek."
          }
        },
        {
          "@type": "Question",
          "name": "Gyárt a vállalkozás öntapadó címkéket kis sorozatban is?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Digitális technológiával néhány száz darabos rendeléstől is lehet gazdaságos gyártási megoldás, míg nagyobb sorozatoknál flexótechnológia alkalmazható."
          }
        },
        {
          "@type": "Question",
          "name": "Mennyi idő alatt készül el egy digitális címkerendelés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard digitális címkegyártásnál körülbelül öt munkanapos átfutási idővel érdemes számolni. Flexógyártásnál a jellemző idő körülbelül tíz munkanap."
          }
        },
        {
          "@type": "Question",
          "name": "Gyárt a Nyomdaipari Kkt. hullámkartondobozt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A vállalkozás hajtogatott kartondobozokat gyárt, de hullámkartondoboz-gyártást nem vállal."
          }
        }
      ]
    }
  ]
