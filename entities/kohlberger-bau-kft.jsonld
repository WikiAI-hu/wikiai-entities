    {
      "@type": "FAQPage",
      "@id": "kb:faq",
      "url": "https://www.wikiai.hu/kohlberger-bau-kft/#kohlberger-bau-gyik",
      "isPartOf": {
        "@id": "kb:webpage"
      },
      "about": {
        "@id": "kb:business"
      },
      "inLanguage": "hu-HU",
      "name": "Gyakori kérdések a Kohlberger Bau Kft.-ről",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mi a Kohlberger Bau Kft. fő tevékenysége?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás fő profilja az építőipari kivitelezés és generálkivitelezés. Családi és társasházak, szerkezetépítési, szárazépítési, homlokzati, földmunka- és más szakipari feladatok egyaránt megjelennek a tevékenységében."
          }
        },
        {
          "@type": "Question",
          "name": "Mikor alapították a Kohlberger Bau Kft.-t?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jelenlegi társaság 2017. január 18-án alakult."
          }
        },
        {
          "@type": "Question",
          "name": "Ki a vállalkozás ügyvezetője?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Kohlberger Bau Kft. ügyvezetője Kohlberger Zoltán."
          }
        },
        {
          "@type": "Question",
          "name": "Hol működik a vállalkozás?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A társaság jogi székhelye Rábacsécsényben található, a nyilvános hajdúszoboszlói kapcsolati cím pedig 4200 Hajdúszoboszló, Dobó István utca 12/A. A kivitelezési jelenlét erősen kapcsolódik Debrecenhez és Hajdú-Bihar vármegyéhez is."
          }
        },
        {
          "@type": "Question",
          "name": "Vállalnak családi ház generálkivitelezést?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A családi házak teljes körű generálkivitelezése a hivatalosan bemutatott szolgáltatások között szerepel, hagyományos falazási technológiával és Leier Típusházakhoz kapcsolódó kivitelezéssel is."
          }
        },
        {
          "@type": "Question",
          "name": "Van társasházi tapasztalatuk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A saját 2×6 lakásos hajdúszoboszlói projekt mellett a hivatalos referenciaoldal egy 201 lakásos társasházat is felsorol."
          }
        },
        {
          "@type": "Question",
          "name": "Dolgoztak ipari és intézményi projekteken?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A dokumentált referenciák között szerepel stadion, konferenciaközpont, gyógyszeripari létesítmény, autóipari gyár, egyetem, múzeum és más nagyobb projekt."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen saját gépekkel dolgoztak a 2024-es vállalati bemutatás szerint?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A 2024-es bemutatkozás többek között 600 m²-es homlokzati állványrendszert, DOKA födémzsalut, különböző teherbírású szállítójárműveket, kotró-rakodógépet, gumitalpas forgó kotrót, szóróberendezéseket és betonipari eszközöket sorolt fel."
          }
        },
        {
          "@type": "Question",
          "name": "Van nyilvános kivitelezési árlista?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nincs általános nyilvános árlista. A kivitelezés ára a konkrét tervtől, műszaki tartalomtól, mérettől, anyagoktól, helyszíntől és a projekt körülményeitől függ."
          }
        },
        {
          "@type": "Question",
          "name": "Hogyan lehet árajánlatot kérni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Telefonon a +36 20 254 8082 számon, e-mailben az info@kohlberger.hu címen, vagy a hivatalos weboldal kapcsolatfelvételi felületén lehet egyeztetést kezdeményezni."
          }
        }
      ]
    },
