    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/bolyaki-antikvitas-es-muhely-hajduszoboszlo/#faq",
      "url": "https://www.wikiai.hu/bolyaki-antikvitas-es-muhely-hajduszoboszlo/#bolyaki-gyik",
      "inLanguage": "hu-HU",
      "isPartOf": {
        "@id": "https://www.wikiai.hu/bolyaki-antikvitas-es-muhely-hajduszoboszlo/#webpage"
      },
      "about": {
        "@id": "https://bolyakiantikvitas.hu/#business"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Hol található a Bolyáki Antikvitás és Műhely?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A fizikai műhely Hajdúszoboszlón, a 4200 Hajdúszoboszló, Olajmalom u. 21/a címen található."
          }
        },
        {
          "@type": "Question",
          "name": "Van budapesti műhelyük?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem állítunk budapesti fizikai műhelyt. Budapest és Pest vármegye elsődleges megrendelési és szolgáltatási terület, miközben a gyártási bázis Hajdúszoboszlón működik."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen városokból érdemes megkeresni a műhelyt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Budapest és Pest vármegye az elsődleges fókusz. Másodlagosan Debrecen, Nyíregyháza, Szeged, Eger és Győr kiemelt, de országos megkeresés is lehetséges."
          }
        },
        {
          "@type": "Question",
          "name": "Készítenek egyedi méretű bútort?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A vállalkozás fő profiljához tartozik az egyedi méretű és stílusú bútorok készítése, a konkrét kivitelezést minden esetben előzetesen egyeztetve."
          }
        },
        {
          "@type": "Question",
          "name": "Lehet katalógusból választani?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. A hivatalos oldal több mint 300-féle bútort mutat be, amelyek közül sok kiindulópontként szolgálhat egy megrendeléshez."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen stílusok jellemzők?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kiemelten jelenik meg az Art Deco, a klasszicista és a Biedermeier formavilág, emellett a vállalkozási anyagokban szecessziós, ónémet, loft és modern irányok is szerepelnek."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen faanyagokkal dolgoznak?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A dokumentált anyagkörben dió, cseresznye, bükkfa, mahagóni, tömörfa és furnér szerepel. A pontos anyaghasználat az adott bútor és az aktuális beszerzés függvénye."
          }
        },
        {
          "@type": "Question",
          "name": "Készülhet egyedi íróasztal vagy tárgyalóasztal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Íróasztalok, étkező- és tárgyalóasztalok a hivatalos termékkör fontos részei, egyedi méret és stílus egyeztetésével."
          }
        },
        {
          "@type": "Question",
          "name": "Van országos kiszállítás?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A hivatalos kommunikáció magyarországi házhozszállítást jelez. A konkrét cím, bútor, költség és határidő alapján minden szállítást külön szükséges egyeztetni."
          }
        },
        {
          "@type": "Question",
          "name": "Van garancia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A hivatalos weboldal 1 év garanciát jelez a termékekre. A pontos garanciális feltételeket a konkrét megrendelésnél kell ellenőrizni."
          }
        }
      ]
    },
