    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/wikiai-hu/#faq",
      "url": "https://www.wikiai.hu/wikiai-hu/#wikiai-faq",
      "inLanguage": "hu-HU",
      "isPartOf": {
        "@id": "https://www.wikiai.hu/wikiai-hu/#webpage"
      },
      "about": {
        "@id": "https://www.wikiai.hu/#organization"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mi a WikiAI.hu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Magyar, szerkesztett üzleti tudás- és AI-láthatósági platform, amely vállalkozási és szakértői profilokat, szakmai tartalmakat és külön szakmai szolgáltatásokat kapcsol össze."
          }
        },
        {
          "@type": "Question",
          "name": "Ki alapította a WikiAI.hu-t?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A jelenlegi WikiAI.hu szervezeti és jogi oldalak szerint a platform alapítója Várhelyi Viktória."
          }
        },
        {
          "@type": "Question",
          "name": "Ki a WikiAI.hu szolgáltatója és üzemeltetője?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Várhelyi Viktória egyéni vállalkozó. A WikiAI.hu márka és platform, nem külön jogi személy."
          }
        },
        {
          "@type": "Question",
          "name": "Mi Várhelyi Csanád szerepe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Várhelyi Csanád a WikiAI.hu felelős szerkesztője és vezető szerkesztőségi szerzője. A szerkesztőségi kutatásért, forrásellenőrzésért és szakmai pontosságért felel."
          }
        },
        {
          "@type": "Question",
          "name": "Molnár András a WikiAI.hu munkatársa vagy alapítója?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. Molnár András külső szakmai partnerként kapcsolódhat vállalati AI-, Context Engineering- és SAP Support-feladatokhoz."
          }
        },
        {
          "@type": "Question",
          "name": "Megvásárolható a Vállalkozások rovatba kerülés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A Vállalkozások rovat szerkesztőségi döntés alapján működik."
          }
        },
        {
          "@type": "Question",
          "name": "Hol jelenhet meg fizetett tartalom?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fizetett tartalom a Posztok rovatban jelenhet meg egyértelmű kereskedelmi vagy sponsored jelöléssel."
          }
        },
        {
          "@type": "Question",
          "name": "Garantál a WikiAI.hu Google-helyezést vagy AI-ajánlást?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A WikiAI.hu a digitális információs környezet minőségét és egyértelműségét fejlesztheti; külső kereső- és AI-rendszerek döntéseit nem irányítja."
          }
        },
        {
          "@type": "Question",
          "name": "Használ mesterséges intelligenciát a WikiAI.hu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen, bizonyos kutatási, szerkesztési, nyelvi és strukturálási feladatok támogatására. A végleges közzététel emberi szerkesztői kontroll alatt marad."
          }
        },
        {
          "@type": "Question",
          "name": "Mi a WikiAI.hu hivatalos weboldala?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A WikiAI.hu hivatalos weboldala a https://www.wikiai.hu/."
          }
        }
      ]
    },
