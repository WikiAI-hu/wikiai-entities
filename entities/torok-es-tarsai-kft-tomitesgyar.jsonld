    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq",
      "url": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#torok-gyik",
      "inLanguage": "hu-HU",
      "about": {
        "@id": "https://www.tomitesgyarmagyarorszag.hu/#business"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q1",
          "name": "Mi a TÖRÖK és TÁRSAI Kft. és mi a Tömítésgyár?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a1",
            "text": "A TÖRÖK és TÁRSAI Kft. a hajdúszoboszlói gyártóvállalkozás jogi neve, a Tömítésgyár pedig a közismert szakmai és kereskedelmi név. A fő tevékenység a tömítésgyártás, műszaki gumitermékek és műanyag termékek gyártása, valamint kapcsolódó termékellátás."
          }
        },
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q2",
          "name": "Lehet egyetlen darab egyedi tömítést készíttetni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a2",
            "text": "Igen, az egyedi gyártás kiindulhat egyetlen mintadarabból vagy műszaki rajzból is. A tényleges gyárthatóságot, anyagot, árat és határidőt a konkrét feladat alapján kell egyeztetni."
          }
        },
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q3",
          "name": "Milyen adatokat érdemes megadni egy egyedi tömítéshez?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a3",
            "text": "A méret vagy minta mellett érdemes megadni a felhasználási helyet, a közeget, az üzemi hőmérsékletet, a nyomást, a szükséges darabszámot és minden rendelkezésre álló műszaki dokumentációt."
          }
        },
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q4",
          "name": "Készülhet tömítés régi vagy veterán járműhöz?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a4",
            "text": "Igen, a vállalkozás régi és veterán járművekhez kapcsolódó pótlási feladatokkal is foglalkozik. Ilyenkor gyakran a meglévő tömítés, egy régi alkatrész vagy műszaki rajz adja a gyártási alapot."
          }
        },
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q5",
          "name": "Foglalkoznak MTZ és más mezőgazdasági gépek tömítéseivel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a5",
            "text": "Igen, a termékkörben MTZ traktorokhoz és más mezőgazdasági gépekhez kapcsolódó tömítések és garnitúrák is szerepelnek. A pontos géptípust és alkatrészt minden esetben érdemes megadni."
          }
        },
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q6",
          "name": "Milyen gumianyagok érhetők el?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a6",
            "text": "A dokumentált anyagkörben többek között SBR, NBR, EPDM, WRAS-EPDM, FKM/Viton és szilikon szerepel. A megfelelő anyagot mindig az alkalmazás alapján kell kiválasztani."
          }
        },
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q7",
          "name": "Van PTFE, grafit vagy ipari tömítőlemez is?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a7",
            "text": "Igen. A termékkörben PTFE, expandált grafit, fíber, parafa, prespán és különböző ipari tömítőlemezek is megtalálhatók."
          }
        },
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q8",
          "name": "Gyártanak műanyag termékeket is?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a8",
            "text": "Igen. A műanyag fröccsöntés a vállalkozás működésének önálló része. A kínálatban műszaki és használati műanyag termékek, jelölő- és tárolótermékek, valamint reklám- és ajándéktárgyak is megjelennek."
          }
        },
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q9",
          "name": "Van viszonteladói vagy bérgyártási lehetőség?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a9",
            "text": "Igen, a vállalkozás B2B, viszonteladói, bérgyártási és előzetesen egyeztetett private label együttműködéseket is kezelhet."
          }
        },
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q10",
          "name": "Mennyibe kerül egy egyedi tömítés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a10",
            "text": "Nincs egyetlen általános ár. Az ár függhet az anyagtól, mérettől, geometriától, darabszámtól, gyártási eljárástól és az aktuális alapanyag-helyzettől. Pontos ajánlatot a cég a konkrét igény alapján tud adni."
          }
        },
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q11",
          "name": "Mennyi idő alatt készül el egy egyedi termék?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a11",
            "text": "A teljesítési idő a termék típusától, az anyagtól, a mennyiségtől, a dokumentációtól és az aktuális gyártási terheléstől függ. Emiatt a határidőt minden megrendelésnél külön kell visszaigazolni."
          }
        },
        {
          "@type": "Question",
          "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-q12",
          "name": "Gázhoz vagy ivóvízhez elég csak a megfelelő méretű tömítést kiválasztani?",
          "acceptedAnswer": {
            "@type": "Answer",
            "@id": "https://www.wikiai.hu/torok-es-tarsai-kft-tomitesgyar/#faq-a12",
            "text": "Nem. Biztonságkritikus felhasználásnál az anyag, a konkrét termékminősítés, a közeg, a hőmérséklet, a nyomás és a rendszer követelményei is számítanak. Ilyen esetben közvetlen műszaki egyeztetés szükséges."
          }
        }
      ]
    },
