    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/nyomdaipari-kkt-debrecen-cimkegyartas/#faq",
      "url": "https://www.wikiai.hu/nyomdaipari-kkt-debrecen-cimkegyartas/#nyomdaipari-kkt-gyik",
      "inLanguage": "hu-HU",
      "isPartOf": {
        "@id": "https://www.wikiai.hu/nyomdaipari-kkt-debrecen-cimkegyartas/#webpage"
      },
      "about": {
        "@id": "https://www.wikiai.hu/nyomdaipari-kkt-debrecen-cimkegyartas/#business"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mi a Nyomdaipari Kkt. fő szakterülete?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A vállalkozás elsődleges szakterülete az ipari címkegyártás. Emellett falt kartondobozokat, használati utasításokat és számos további nyomdaterméket gyárt, főként vállalati és gyártó ügyfeleknek."
          }
        },
        {
          "@type": "Question",
          "name": "Gyárt a vállalkozás öntapadó címkéket kis sorozatban is?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Digitális technológiával néhány száz darabos rendeléstől is lehet gazdaságos gyártási megoldás, míg nagyobb sorozatoknál flexótechnológia alkalmazható. A konkrét gazdaságos mennyiség a mérettől, anyagtól, grafikától és utómunkától is függ."
          }
        },
        {
          "@type": "Question",
          "name": "Mennyi idő alatt készül el egy digitális címkerendelés?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Standard digitális címkegyártásnál körülbelül öt munkanapos átfutási idővel érdemes számolni. Flexógyártásnál a jellemző idő körülbelül tíz munkanap, de az aktuális vállalást mindig az adott specifikáció és kapacitás határozza meg."
          }
        },
        {
          "@type": "Question",
          "name": "Gyárt a Nyomdaipari Kkt. hullámkartondobozt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A vállalkozás falt kartondobozokat gyárt, de hullámkartondoboz-gyártást nem vállal."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen adatok szükségesek egy pontos címke- vagy dobozajánlathoz?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Általában szükség van a méretre, mennyiségre, színszámra, alapanyagra, kívánt felületkezelésre és a felhasználási körülményekre. Meglévő termék újragyártásánál grafikai állomány és fizikai minta is nagy segítséget jelenthet."
          }
        },
        {
          "@type": "Question",
          "name": "Kizárólag Debrecen környékén dolgozik a vállalkozás?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A gyártóüzem Debrecenben található, a vállalkozás azonban országos lefedettséggel dolgozik, és több európai országba, valamint Ausztráliába is teljesített már közvetlen szállítást."
          }
        }
      ]
    },
