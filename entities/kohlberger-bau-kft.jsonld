    },
    {
      "@type": "Thing",
      "@id": "https://www.wikiai.hu/kohlberger-bau-kft/#reference-futura",
      "name": "Futura múzeum – Mosonmagyaróvár",
      "description": "Az épület különleges geometriájához kapcsolódó szárazépítési munka."
    },
    {
      "@type": "Thing",
      "@id": "https://www.wikiai.hu/kohlberger-bau-kft/#reference-dust-wall",
