    {
      "@type": "Service",
      "@id": "https://www.wikiai.hu/porvadaszok-matractisztitas-debrecen/#matractisztitas",
      "name": "Helyszíni, száraz matracmélytisztítás Debrecenben",
      "serviceType": "száraz matracmélytisztítás",
