    {
      "@type": "FAQPage",
      "@id": "https://www.wikiai.hu/varganya-etterem-matraszentimre/#faq",
      "url": "https://www.wikiai.hu/varganya-etterem-matraszentimre/#varganya-gyik",
      "inLanguage": "hu-HU",
      "about": {
        "@id": "https://www.matraietterem.hu/#restaurant"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Hol található a Vargánya Étterem?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "3235 Mátraszentimre, Arany János utca 12."
          }
        },
        {
          "@type": "Question",
          "name": "Csak a panzió vendégei étkezhetnek itt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. Az étterem külsős vendégek számára is nyitott."
          }
        },
        {
          "@type": "Question",
          "name": "Hogyan lehet asztalt foglalni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Telefonon vagy SMS-ben a +36 30 278 2155 számon."
          }
        },
        {
          "@type": "Question",
          "name": "Milyen konyhát képvisel az étterem?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Magyar–szlovák, mátrai jellegű családi konyhát, amelyben vad-, gomba- és vargányás fogások is hangsúlyosak."
          }
        },
        {
          "@type": "Question",
          "name": "Lehet elvitelre rendelni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen, telefonos egyeztetéssel és személyes átvétellel. Házhoz szállítás nincs."
          }
        },
        {
          "@type": "Question",
          "name": "Lehet kutyával érkezni?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen, a beltér és a terasz is szóba jöhet. Érdemes előre jelezni a kutyás érkezést."
          }
        },
        {
          "@type": "Question",
          "name": "Van gyermekmenü?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Két etetőszék és pelenkázási lehetőség is rendelkezésre áll."
          }
        },
        {
          "@type": "Question",
          "name": "Akadálymentes az étterem?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nem. A bejárat lépcsős, rámpa és akadálymentes mosdó nincs."
          }
        },
        {
          "@type": "Question",
          "name": "Fogadnak csoportokat?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen, előzetes egyeztetéssel kisebb turistacsoportokhoz, családi alkalmakhoz és céges étkezésekhez is használható a hely."
          }
        },
        {
          "@type": "Question",
          "name": "Van parkolás?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Igen. Néhány autó közvetlenül az épület előtt, további járművek pedig a közeli parkolóban férnek el."
          }
        }
      ]
    },
